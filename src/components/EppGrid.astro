<style>
  .asepp-wrap {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 35px 16px;
    box-sizing: border-box;
    position: relative;
    background: #ffffff;
  }
  .asepp-wrap::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: linear-gradient(to bottom, rgba(49,49,49,0.90) 0%, rgba(49,49,49,1) 100%), url('https://banamailing.com/andes-safety/wp-content/uploads/2026/05/DSC4512-jpg.avif');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    clip-path: polygon(0 0, 100% 5.7%, 100% 100%, 0 100%);
    z-index: 0;
  }
  .asepp-inner {
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .asepp-header {
    margin: 0 0 24px;
    background: rgba(4, 147, 210, 0.40);
    border-radius: 30px 30px 30px 0;
    padding: 19px 36px;
    text-align: center;
  }

  .asepp-header-title {
    margin: 0 0 12px;
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }

  .asepp-header-text {
    margin: 0;
    font-size: clamp(0.75rem, 1.1vw, 0.88rem);
    color: #ffffff;
    line-height: 1.53;
    font-style: italic;
  }

  .asepp-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .asepp-card {
    position: relative;
    background: #fff;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0,0,0,0.10);
    text-decoration: none;
    display: block;
    aspect-ratio: 25 / 30;
    transition: transform 0.6s ease, box-shadow 0.6s ease;
  }

  .asepp-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(4,147,210,0.14);
  }

  /* Imagen centrada */
  .asepp-img {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    height: 66%;
    z-index: 2;
  }

  .asepp-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.7s ease;
    transform-origin: center bottom;
  }

  .asepp-card:hover .asepp-img img {
    transform: rotate(5deg) scale(1.04);
  }

  /* Franja azul diagonal */
  .asepp-blue {
    position: absolute;
    bottom: -8%;
    left: 0;
    width: 100%;
    height: 40%;
    z-index: 1;
  }

  .asepp-blue svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Cajita blanca */
  .asepp-pill {
    position: absolute;
    bottom: 7%;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    background: #fff;
    border-radius: 50px 50px 50px 0;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    z-index: 3;
    padding: 8px 10px 10px;
    text-align: center;
  }

  .asepp-label {
    font-size: 10px;
    font-style: italic;
    font-weight: 600;
    letter-spacing: 0;
    color: #666;
    line-height: 1;
    margin-bottom: 3px;
    text-transform: uppercase;
  }

  .asepp-name {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    color: #0094d9;
    letter-spacing: 0;
    line-height: 1.1;
  }

  @media (max-width: 900px) {
    .asepp-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .asepp-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .asepp-wrap { padding: 20px 12px; }
  }
</style>
