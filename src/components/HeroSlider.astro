<style>
*{ box-sizing:border-box; }

.as-hero-wrap{
  font-family:'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  width:100%;
  margin-top:-10px;

  background:linear-gradient(
    to bottom,
    #414141 calc(100% - 30px),
    transparent calc(100% - 90px)
  );

  padding:30px 0 0px;
  box-sizing:border-box;
}

.as-slider{
  width:1300px !important; max-width:1300px !important;
  height:440px !important; margin:0 auto !important;
  position:relative; overflow:hidden;
  box-shadow:0 5px 15px rgba(0,0,0,.55);
}
.as-slides{
  width:200%;
  height:440px;
  display:flex;
  animation:andesSlide 18s infinite ease-in-out;
}
.as-slide{
  width:50%;
  min-width:50%;
  height:440px;
  flex:0 0 50%;
  position:relative;
  overflow:hidden;
}
.as-bg-s1{ background-image:url('https://banamailing.com/andes-safety/wp-content/uploads/2026/05/Proteccion-Caidas-nuevo-2-1.avif'); background-size:cover; background-position:center; }
.as-bg-s2{ background-image:url('https://banamailing.com/andes-safety/wp-content/uploads/2026/05/emergencia-y-bloqueo-nuevo-2-1.avif'); background-size:cover; background-position:center; }
@media(max-width:768px){
  .as-bg-s1{ background-image:url('https://banamailing.com/andes-safety/wp-content/uploads/2026/05/Proteccion-Caidas-moviles-nuevo-1.avif'); }
  .as-bg-s2{ background-image:url('https://banamailing.com/andes-safety/wp-content/uploads/2026/05/emergencia-y-bloqueo-nuevo-moviles-2-1.avif'); }
}

.as-brand-box{ display:flex; align-items:center; gap:22px; width:max-content; background:#fff; padding:12px 32px 10px; border-radius:26px 26px 0 0; margin-bottom:0; }
.as-brand-box img{ height:34px; width:auto; object-fit:contain; }

.as-overlay{ position:absolute; inset:0; background:linear-gradient(90deg,rgba(0,0,0,.15) 0%,rgba(0,0,0,.05) 45%,rgba(0,0,0,.18) 100%); z-index:1; pointer-events:none; }

.as-content{ position:absolute; top:50%; left:64%; transform:translate(-50%,-50%); z-index:5; color:#fff; width:650px; }

.as-title-top{ position:relative; display:inline-flex; align-items:center; justify-content:center; height:74px; padding:0 58px 0 52px; background:#2f9be8; color:#fff; font-size:58px; font-weight:800; line-height:1; letter-spacing:1px; text-transform:uppercase; clip-path:polygon(7% 0,100% 0,92% 100%,0 100%); }
.as-title-bottom{ margin-top:14px; display:flex; align-items:flex-end; gap:18px; }
.as-title-bottom span{ font-size:50px; font-weight:300; line-height:1; }
.as-title-bottom strong{ font-size:68px; font-weight:700; line-height:.9; }
.as-subtitle{ margin-top:18px; font-size:21px; font-style:italic; font-weight:300; }

.as-content-left{ left:33% !important; top:47% !important; width:720px !important; }
.as-title-top-left{ margin-top:0 !important; font-size:42px !important; height:64px !important; padding:0 34px 0 28px !important; clip-path:none !important; }
.as-subtitle-left{ margin-top:22px !important; max-width:620px; font-size:24px !important; line-height:1.45 !important; font-style:normal !important; }

.as-logo{ position:absolute; right:0; top:50%; transform:translateY(-50%); z-index:6; width:105px; height:350px; background:#fff; border-radius:28px 0 0 28px; display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,.22); }
.as-logo img{ position:absolute !important; width:200px !important; min-width:200px !important; max-width:none !important; height:auto !important; top:50%; left:50%; transform:translate(-50%,-50%) rotate(270deg); }

.as-arrow{ position:absolute; top:50%; transform:translateY(-50%); z-index:10; width:21px; height:21px; border:0 !important; background:transparent !important; color:#fff; font-size:21px; font-family:Arial,Helvetica,sans-serif; line-height:21px; text-align:center; cursor:pointer; padding:0; box-shadow:none !important; outline:none !important; }
.as-arrow:hover,.as-arrow:focus,.as-arrow:active{ background:transparent !important; box-shadow:none !important; outline:none !important; }
.as-prev{ left:12px; }
.as-next{ right:12px; }

@media(max-width:1300px){ .as-slider{ width:100% !important; max-width:100% !important; } }
@media(max-width:1024px){
  .as-slider{ max-width:94% !important; }
  .as-content{ width:440px !important; left:56% !important; }
  .as-title-top{ font-size:44px !important; height:58px !important; padding:0 36px 0 32px !important; }
  .as-title-bottom span{ font-size:38px !important; }
  .as-title-bottom strong{ font-size:56px !important; }
  .as-subtitle{ font-size:17px !important; }
  .as-logo{ width:80px !important; height:270px !important; }
  .as-logo img{ width:160px !important; min-width:160px !important; }
  .as-content-left{ left:38% !important; width:520px !important; }
  .as-title-top-left{ font-size:30px !important; }
  .as-subtitle-left{ font-size:18px !important; }
}
@media(max-width:480px){
  .as-slider,.as-slides,.as-slide,.as-slide picture,.as-slide img.bg{ height:333px !important; }
  .as-slider{ width:100% !important; max-width:100% !important; }
  .as-slide img.bg{ object-position:center center !important; }
  .as-content{ width:82% !important; left:48% !important; top:32% !important; text-align:left !important; }
  .as-title-top{ height:38px !important; font-size:24px !important; padding:0 26px 0 22px !important; }
  .as-title-bottom{ justify-content:flex-start !important; gap:8px !important; margin-top:8px !important; }
  .as-title-bottom span{ font-size:22px !important; }
  .as-title-bottom strong{ font-size:32px !important; }
  .as-subtitle{ font-size:11px !important; line-height:1.3 !important; max-width:220px !important; margin-top:8px !important; }
  .as-logo{ width:34px !important; height:125px !important; border-radius:14px 0 0 14px !important; }
  .as-logo img{ width:100px !important; min-width:100px !important; }
  .as-arrow{ display:block !important; width:34px !important; height:34px !important; font-size:34px !important; line-height:34px !important; top:50% !important; }
  .as-prev{ left:6px !important; }
  .as-next{ right:6px !important; }
  .as-content-left{ left:48% !important; top:34% !important; width:82% !important; }
  .as-title-top-left{ font-size:19px !important; height:40px !important; width:280px !important; padding:0 5px !important; }
  .as-subtitle-left{ font-size:12px !important; line-height:1.4 !important; max-width:250px !important; }
}

@keyframes andesSlide{
  0%{ transform:translateX(0); }
  42%{ transform:translateX(0); }
  55%{ transform:translateX(-50%); }
  92%{ transform:translateX(-50%); }
  100%{ transform:translateX(0); }
}
</style>

