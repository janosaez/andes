<style>
.andes-footer{
  width:100%;
  font-family:Arial, sans-serif;
  color:#54595F;
  background:#fff;
}

.andes-footer-main{
  max-width:1200px;
  min-height:400px;
  margin:0 auto;
  padding:70px 20px 40px;
  background:#fff;
}

.andes-footer-grid{
  display:grid;
  grid-template-columns:1.35fr 1.1fr 1.2fr .9fr;
  gap:55px;
}

.andes-footer h3{
  font-size:16px;
  color:#0494D4;
  margin:0 0 20px;
  font-weight:700;
}

.andes-footer .mt{
  margin-top:32px;
}

.andes-footer ul{
  list-style:none;
  padding:0;
  margin:0;
}

.andes-footer li{
  margin-bottom:12px;
}

.andes-footer a{
  color:#54595F;
  text-decoration:none;
  font-size:16px;
  line-height:1.35;
}

.andes-footer li a::before{
  content:"›";
  color:#0494D4;
  font-weight:700;
  font-size:24px;
  margin-right:10px;
  vertical-align:-2px;
}

.andes-footer .social a::before{
  content:"";
  margin:0;
}

.andes-footer a:hover{
  color:#0494D4;
}

.andes-footer p{
  font-size:16px;
  line-height:1.45;
  margin:0 0 18px;
}

.andes-footer strong{
  color:#0494D4;
}

.andes-footer-info{
  width:100%;
  background:#FCFCFC;
  padding:30px 20px;
}

.andes-footer-info-inner{
  max-width:1140px;
  margin:0 auto;
  display:grid;
  grid-template-columns:220px 1fr;
  align-items:center;
  gap:35px;
}

.andes-footer-info img{
  max-width:190px;
  width:100%;
  height:auto;
}

.andes-footer-info p{
  margin:0;
  font-style:italic;
  font-size:15px;
  line-height:1.55;
}

.andes-footer-copy{
  width:100%;
  background:#54595F;
  color:#fff;
  padding:18px 20px;
}

.andes-footer-copy-inner{
  max-width:1140px;
  margin:0 auto;
  text-align:center;
  font-size:14px;
  font-weight:700;
}

.andes-whatsapp-widget{
  position:fixed;
  left:30px;
  bottom:28px;
  z-index:99999;
  font-family:Arial, sans-serif;
}

.andes-wa-toggle,
.andes-wa-toggle:hover,
.andes-wa-toggle:focus,
.andes-whatsapp-widget.active .andes-wa-toggle{
  background:#28b63f !important;
  color:#fff !important;
}

.andes-wa-toggle{
  width:58px;
  height:58px;
  border-radius:50%;
  border:0;
  background:#28b63f;
  color:#fff;
  cursor:pointer;
  box-shadow:0 8px 20px rgba(0,0,0,.25);
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  transition:transform .35s ease;
}

.andes-wa-toggle svg{
  width:34px;
  height:34px;
  fill:#fff;
}

.wa-icon,
.x-icon{
  position:absolute;
  transition:all .35s ease;
}

.x-icon{
  font-size:42px;
  line-height:1;
  opacity:0;
  transform:rotate(-180deg) scale(.4);
}

.andes-whatsapp-widget.active .wa-icon{
  opacity:0;
  transform:rotate(180deg) scale(.4);
}

.andes-whatsapp-widget.active .x-icon{
  opacity:1;
  transform:rotate(0) scale(1);
}

.andes-wa-tooltip{
  position:absolute;
  left:68px;
  bottom:2px;
  background:#f5f7fa;
  color:#111;
  font-size:12px;
  line-height:1.5;
  padding:10px 12px;
  border-radius:4px;
  width:180px;
  box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.andes-whatsapp-widget.active .andes-wa-tooltip{
  display:none;
}

.andes-wa-panel{
  position:absolute;
  left:0;
  bottom:78px;
  width:350px;
  background:#fff;
  border-radius:5px;
  overflow:hidden;
  box-shadow:0 8px 28px rgba(0,0,0,.18);
  opacity:0;
  pointer-events:none;
  transform:translateY(20px);
  transition:all .35s ease;
}

.andes-whatsapp-widget.active .andes-wa-panel{
  opacity:1;
  pointer-events:auto;
  transform:translateY(0);
}

.andes-wa-header{
  background:#28b63f;
  color:#fff;
  padding:20px;
  display:flex;
  gap:14px;
  align-items:flex-start;
}

.andes-wa-header svg{
  width:38px;
  height:38px;
  fill:#fff;
  flex:0 0 auto;
}

.andes-wa-header strong{
  font-size:18px;
  display:block;
  margin-bottom:8px;
}

.andes-wa-header p{
  margin:0;
  font-size:12px;
  line-height:1.6;
}

.andes-wa-body{
  padding:18px 20px;
}

.andes-wa-body > p{
  margin:0 0 18px;
  color:#a3a8b3;
  font-size:11px;
  font-weight:700;
}

.andes-wa-option{
  height:74px;
  background:#f5f7fa;
  display:flex;
  align-items:center;
  gap:18px;
  padding:0 15px;
  margin-bottom:12px;
  text-decoration:none;
  color:#4b5563;
  border-left:2px solid #28b63f;
  transition:all .25s ease;
}

.andes-wa-option:hover{
  background:#fff;
  box-shadow:0 8px 22px rgba(0,0,0,.10);
  transform:translateY(-2px);
}

.big-wa{
  width:46px;
  height:46px;
  border-radius:50%;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:26px;
}

.big-wa img{
  width:46px;
  height:46px;
  object-fit:contain;
}

.andes-wa-option span:nth-child(2){
  flex:1;
  font-size:14px;
}

.small-wa img{
  width:40px;
  height:40px;
  object-fit:contain;
  display:block;
  opacity:.9;
}

@media(max-width:900px){
  .andes-footer-main{
    min-height:auto;
    padding:45px 22px 30px;
  }

  .andes-footer-grid{
    grid-template-columns:1fr;
    gap:30px;
  }

  .andes-footer-info-inner{
    grid-template-columns:1fr;
    text-align:center;
    gap:18px;
  }

  .andes-footer-info img{
    margin:0 auto;
  }
}

@media(max-width:480px){
  .andes-whatsapp-widget{
    left:16px;
    bottom:18px;
  }

  .andes-wa-panel{
    width:340px;
    max-width:calc(100vw - 32px);
  }

  .andes-wa-tooltip{
    width:145px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
  const widget = document.querySelector(".andes-whatsapp-widget");
  const btn = document.querySelector(".andes-wa-toggle");

  if(btn && widget){
    btn.addEventListener("click", function(){
      widget.classList.toggle("active");
    });
  }
});
</script>
