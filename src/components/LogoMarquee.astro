<style>
.as-logo-marquee {
  width: 100vw !important;
  max-width: none !important;
  margin-left: calc(50% - 50vw) !important;
  height: 150px !important;
  min-height: 150px !important;
  transform: none !important;
  background: #fff !important;
  overflow: hidden !important;
  display: flex !important;
  align-items: center !important;
}
.as-logo-track {
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 34px;
}
.as-logo-row {
  display: flex;
  width: max-content;
  animation: asLogoMove 28s linear infinite;
  will-change: transform;
}
.as-logo-row-reverse {
  animation-direction: reverse;
  animation-duration: 32s;
}
.as-logo-set {
  display: flex;
  align-items: center;
  gap: 34px;
  padding-right: 34px;
  flex: 0 0 auto;
}
.as-logo-set img {
  width: auto !important;
  height: auto !important;
  max-width: 84px !important;
  max-height: 29px !important;
  object-fit: contain;
  display: block;
  flex: 0 0 auto;
}
.as-logo-row:hover {
  animation-play-state: paused;
}
@keyframes asLogoMove {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
@media (max-width: 768px) {
  .as-logo-marquee {
    width: 100vw !important;
    max-width: none !important;
    height: 170px !important;
    min-height: 170px !important;
    margin: 0 auto !important;
    background: #fff !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
  }
  .as-logo-track { gap: 22px; }
  .as-logo-row { animation-duration: 20s; }
  .as-logo-row-reverse { animation-duration: 24s; }
  .as-logo-set { gap: 24px; padding-right: 24px; }
  .as-logo-set img { max-width: 74px !important; max-height: 25px !important; }
}
</style>
